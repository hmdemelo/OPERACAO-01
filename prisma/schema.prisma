generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String            @id @default(uuid())
  name              String
  email             String            @unique
  passwordHash      String
  role              Role              @default(STUDENT)
  phone             String?
  cpf               String?
  birthDate         DateTime?
  targetExam        String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  active            Boolean           @default(true)
  addressCity       String?
  addressState      String?
  dailyHours        Int?
  educationLevel    String?
  showAnsweredQuestions Boolean       @default(false)
  appVersion        String            @default("v1")
  mentorLinks       MentorshipLink[]  @relation("MentorLinks")
  studentLink       MentorshipLink?   @relation("StudentLinks")
  logs              StudyLog[]
  authoredHistory   StudyLogHistory[] @relation("HistoryAuthor")
  userConcursos     UserConcurso[]
  userSubjects      UserSubject[]
  weeklyPlans       WeeklyPlan[]
  uploadedQuestions Question[]        @relation("QuestionUploader")
  approvedQuestions Question[]        @relation("QuestionApprover")
  questionAnswers   QuestionAnswer[]
  studyGrid         StudyGrid?
}

model MentorshipLink {
  id        String   @id @default(cuid())
  mentorId  String
  studentId String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  mentor    User     @relation("MentorLinks", fields: [mentorId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([studentId])
}

model StudyLog {
  id                String            @id @default(cuid())
  userId            String
  date              DateTime
  hoursStudied      Float
  questionsAnswered Int
  correctAnswers    Int
  topic             String?
  createdAt         DateTime          @default(now())
  contentId         String?
  subjectId         String
  content           Content?          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  subject           Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  history           StudyLogHistory[]
  weeklyPlanItem    WeeklyPlanItem?

  @@index([userId])
  @@index([date])
}

model Subject {
  id          String           @id @default(cuid())
  name        String
  createdAt   DateTime         @default(now())
  active      Boolean          @default(true)
  description String?          @db.VarChar(2048)
  contents    Content[]
  studyLogs   StudyLog[]
  users       UserSubject[]
  planItems   WeeklyPlanItem[]
  questions   Question[]
}

model Content {
  id          String     @id @default(cuid())
  name        String
  subjectId   String
  createdAt   DateTime   @default(now())
  description String?    @db.VarChar(2048)
  subject     Subject    @relation(fields: [subjectId], references: [id])
  studyLogs   StudyLog[]
  questions   Question[]

  @@index([subjectId])
}

model UserSubject {
  id        String  @id @default(cuid())
  userId    String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

model UserConcurso {
  id         String   @id @default(cuid())
  userId     String
  concursoId String
  concurso   Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, concursoId])
}

model Concurso {
  id          String         @id @default(cuid())
  name        String
  description String?        @db.VarChar(2048)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  users       UserConcurso[]
}

model StudyLogHistory {
  id             String   @id @default(cuid())
  studyLogId     String
  previousValues Json
  newValues      Json
  changedById    String
  changedAt      DateTime @default(now())
  changedBy      User     @relation("HistoryAuthor", fields: [changedById], references: [id])
  studyLog       StudyLog @relation(fields: [studyLogId], references: [id], onDelete: Cascade)

  @@index([studyLogId])
  @@index([changedById])
}

model FeaturedStudent {
  id        String   @id @default(cuid())
  name      String
  role      String
  imageUrl  String
  quote     String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Plan {
  id              String   @id @default(cuid())
  title           String
  description     String?
  price           Float
  oldPrice        Float?
  installments    String?
  features        String[]
  whatsappMessage String?
  highlighted     Boolean  @default(false)
  active          Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MethodItem {
  id          String   @id @default(cuid())
  step        String
  title       String
  description String
  icon        String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklyPlan {
  id        String           @id @default(cuid())
  userId    String
  startDate DateTime
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WeeklyPlanItem[]

  @@unique([userId, startDate])
  @@index([userId])
}

model WeeklyPlanItem {
  id              String     @id @default(cuid())
  planId          String
  dayOfWeek       Int
  blockIndex      Int
  subjectId       String?
  content         String?
  durationMinutes Int?
  notes           String?
  questionsDone   Int?
  correctCount    Int?
  completed       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  studyLogId      String?    @unique
  plan            WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  studyLog        StudyLog?  @relation(fields: [studyLogId], references: [id])
  subject         Subject?   @relation(fields: [subjectId], references: [id])

  @@index([planId])
  @@index([subjectId])
}

enum Role {
  ADMIN
  STUDENT
  MENTOR
}

model SystemSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ChangelogEntry {
  id        String   @id @default(cuid())
  version   String   // ex: "v1.4.0"
  date      DateTime @default(now())
  title     String
  content   String   @db.Text
  category  String   // "NEW", "IMPROVEMENT", "FIX"
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

enum QuestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Question {
  id            String         @id @default(cuid())
  externalCode  Int            @unique @default(autoincrement())
  status        QuestionStatus @default(PENDING)

  subjectId     String?
  subject       Subject?       @relation(fields: [subjectId], references: [id])
  contentId     String?
  content       Content?       @relation(fields: [contentId], references: [id])

  stem          String         @db.Text
  alternatives  Json
  correctAnswer String?
  commentary    String?        @db.Text

  source        String?
  year          Int?

  uploadedById  String
  uploadedBy    User           @relation("QuestionUploader", fields: [uploadedById], references: [id])

  createdAt     DateTime       @default(now())
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?          @relation("QuestionApprover", fields: [approvedById], references: [id])
  answers       QuestionAnswer[]

  @@index([status])
  @@index([subjectId])
  @@index([contentId])
}

model QuestionAnswer {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  answeredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

model StudyGrid {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks      StudyBlock[]
  simulations Simulation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model SubjectV2 {
  id        String       @id @default(cuid())
  name      String
  order     Int          @default(0)
  active    Boolean      @default(true)
  contents  ContentV2[]
  blocks    StudyBlock[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ContentV2 {
  id          String              @id @default(cuid())
  subjectV2Id String
  subjectV2   SubjectV2           @relation(fields: [subjectV2Id], references: [id], onDelete: Cascade)
  name        String
  order       Int                 @default(0)
  topics      TopicV2[]
  blocks      StudyContentBlock[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([subjectV2Id])
}

model TopicV2 {
  id          String            @id @default(cuid())
  contentV2Id String
  contentV2   ContentV2         @relation(fields: [contentV2Id], references: [id], onDelete: Cascade)
  title       String            @db.VarChar(255)
  defaultText String?           @db.VarChar(255)
  order       Int               @default(0)
  blocks      StudyTopicBlock[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([contentV2Id])
}

model StudyBlock {
  id               String              @id @default(cuid())
  gridId           String
  grid             StudyGrid           @relation(fields: [gridId], references: [id], onDelete: Cascade)
  subjectV2Id      String
  subjectV2        SubjectV2           @relation(fields: [subjectV2Id], references: [id])
  order            Int                 @default(0)
  visible          Boolean             @default(true)
  contentBlocks    StudyContentBlock[]
  simulationBlocks SimulationBlock[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([gridId])
  @@index([subjectV2Id])
}

model Simulation {
  id        String            @id @default(cuid())
  gridId    String
  grid      StudyGrid         @relation(fields: [gridId], references: [id], onDelete: Cascade)
  title     String            @db.VarChar(120)
  date      DateTime          @db.Date
  blocks    SimulationBlock[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([gridId])
}

model SimulationBlock {
  id             String     @id @default(cuid())
  simulationId   String
  simulation     Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  studyBlockId   String
  studyBlock     StudyBlock @relation(fields: [studyBlockId], references: [id], onDelete: Cascade)
  instructions   String?    @db.Text
  studentNotes   String?    @db.VarChar(500)
  studentResult  String?    @db.VarChar(50)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([simulationId, studyBlockId])
  @@index([simulationId])
  @@index([studyBlockId])
}

model StudyContentBlock {
  id          String            @id @default(cuid())
  blockId     String
  block       StudyBlock        @relation(fields: [blockId], references: [id], onDelete: Cascade)
  contentV2Id String
  contentV2   ContentV2         @relation(fields: [contentV2Id], references: [id])
  order       Int               @default(0)
  visible     Boolean           @default(true)
  topicBlocks StudyTopicBlock[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([blockId])
  @@index([contentV2Id])
}

model StudyTopicBlock {
  id              String            @id @default(cuid())
  contentBlockId  String
  contentBlock    StudyContentBlock @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)
  topicV2Id       String
  topicV2         TopicV2           @relation(fields: [topicV2Id], references: [id])
  customText      String?           @db.VarChar(255)
  order           Int               @default(0)
  visible         Boolean           @default(true)
  completed       Boolean           @default(false)
  f2Bool1         Boolean           @default(false)
  f2Bool2         Boolean           @default(false)
  f2Bool3         Boolean           @default(false)
  f2Bool4         Boolean           @default(false)
  f2Bool5         Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([contentBlockId])
  @@index([topicV2Id])
}
